# Local values for `supabase/config.toml`, loaded automatically by the CLI.
#
# COMMITTED ON PURPOSE: there is not a secret in here, only the addresses this
# stack answers on, and a developer who has to invent them before `supabase
# start` will run is a developer who guesses. A shell variable overrides any line
# here, which is how a production push supplies its own values.
SUPABASE_AUTH_SITE_URL=http://127.0.0.1:3000
# Off locally so a test signup does not have to be confirmed by hand. This is the
# one line you must NOT push without checking what production is set to.
SUPABASE_AUTH_EMAIL_CONFIRMATIONS=false
SUPABASE_AUTH_EMAIL_MAX_FREQUENCY=1s
