# Production values for `supabase/config.toml`, to be copied to
# `supabase/.env.production` and filled in.
#
# THE VALUES BELOW ARE THE ONES THE LINKED PROJECT ACTUALLY REPORTS, read off a
# real `supabase config push` diff rather than guessed. Check them against the
# dashboard before trusting them again: this file ages the moment somebody
# changes a setting there.
#
# HOW IT IS USED:
#
#     npm run supabase:config:push -- supabase/.env.production
#
# That script exports every line here BEFORE calling `supabase config push`, and a
# shell variable overrides `supabase/.env`, so this machine's values do not leak
# into the push. NEVER run a bare `supabase config push`: it loads supabase/.env,
# and with a non-interactive stdin it does not even ask first.

# The base URL of the web app, and what every link in an auth email is built from.
#
# `app.magic-slash.io` is the product host (webapp/lib/hostRouting.ts). This was
# `http://localhost:3000` on the live project until 2026-09-17, which is why every
# auth link in production pointed at the recipient's own machine. If you ever see
# a localhost value here again, it is this file that is wrong, not the project.
SUPABASE_AUTH_SITE_URL=https://app.magic-slash.io
# Whether a new signup must confirm its address before signing in.
# Production is on FALSE today. It is off locally for the same reason — test
# signups need no confirmation — so this one line happens to agree. That is a
# coincidence, not a rule: check the dashboard rather than copying this.
SUPABASE_AUTH_EMAIL_CONFIRMATIONS=false

# How long a sender waits between two auth emails. One second locally so a flow
# can be tested; a minute in production, which is what it is already set to.
SUPABASE_AUTH_EMAIL_MAX_FREQUENCY=1m0s
