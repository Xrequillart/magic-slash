# No peer dependencies installed here, and that is the whole point of the file.
#
# `lucide-react` declares `react` as a peer, and npm 7+ installs peers by default —
# so a plain `npm install` drops React 19 into `design-system/node_modules` beside
# it while both apps are on 18.3.1. Two consequences, both bad: a bundler can pick
# that copy up and ship two Reacts, and `tsc` resolves `react` to an untyped
# install and loses every type in this folder.
#
# React comes from whichever app is compiling these files. Nothing here needs its
# own.
legacy-peer-deps=true
