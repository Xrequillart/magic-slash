// Copy this file to Secrets.xcconfig (same folder) and fill in the values.
// Secrets.xcconfig is git-ignored and included by Base.xcconfig.

// Supabase project host, WITHOUT the scheme: `//` starts a comment in an xcconfig,
// so `https://…` would be cut. The app prepends https:// itself.
SUPABASE_HOST = your-project-ref.supabase.co

// The project's public anon key (the same one the desktop app ships with).
SUPABASE_ANON_KEY = your-anon-key

// Apple Developer team id, used by automatic signing for device builds and archives.
DEVELOPMENT_TEAM = ABCDE12345
