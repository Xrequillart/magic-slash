<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>UIAppFonts</key>
	<array>
		<string>CeraPro-Light.otf</string>
		<string>CeraPro-Medium.otf</string>
		<string>CeraPro-Bold.otf</string>
		<string>CeraPro-Black.otf</string>
	</array>
	<key>KeychainSharedGroup</key>
	<string>$(AppIdentifierPrefix)io.magic-slash.ios.shared</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>SupabaseAnonKey</key>
	<string>$(SUPABASE_ANON_KEY)</string>
	<key>SupabaseHost</key>
	<string>$(SUPABASE_HOST)</string>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>Rabbit</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<false/>
	</dict>
</dict>
</plist>
