# Supabase — same project as the desktop app. The anon/publishable key is
# RLS-protected and safe to expose to the browser.
# On Vercel, set these as Environment Variables (Production + Preview).
NEXT_PUBLIC_SUPABASE_URL=https://csihmkzqbizblpmawhgt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Atlassian OAuth 2.0 (3LO) — SERVER-ONLY, deliberately not NEXT_PUBLIC_*.
# /api/atlassian/token holds the client secret so the desktop app never ships it;
# without both of these that route answers 500 server_not_configured.
# Values come from the Atlassian developer console (developer.atlassian.com).
# The client id is public (it appears in the authorize URL); the secret is not.
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=

# APNs — SERVER-ONLY, deliberately not NEXT_PUBLIC_*. /api/push holds the provider key
# so the desktop app never ships it, and forwards the Mac's sealed notification box to the
# iPhone. Without all four that route answers 500 server_not_configured.
# From developer.apple.com → Certificates, IDs & Profiles → Keys (a key with APNs enabled).
# APNS_KEY_P8 is the .p8 file's content: the PEM as is, the PEM with its newlines written
# as \n on one line, or just the base64 body — all three are accepted.
APNS_KEY_P8=
# The key's 10-character Key ID, and the 10-character Team ID of the account.
APNS_KEY_ID=
APNS_TEAM_ID=
# The iOS app's bundle id (the APNs topic), io.poppins.magicslash (the main app, not the extension).
APNS_TOPIC=
