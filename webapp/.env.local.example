# Supabase — same project as the desktop app. The anon/publishable key is
# RLS-protected and safe to expose to the browser.
# On Vercel, set these as Environment Variables (Production + Preview).
NEXT_PUBLIC_SUPABASE_URL=https://csihmkzqbizblpmawhgt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Atlassian OAuth 2.0 (3LO) — SERVER-ONLY, deliberately not NEXT_PUBLIC_*.
# /api/atlassian/token holds the client secret so the desktop app never ships it;
# without both of these that route answers 500 server_not_configured.
# Values come from the Atlassian developer console (developer.atlassian.com).
# The client id is public (it appears in the authorize URL); the secret is not.
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
