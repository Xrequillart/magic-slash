#!/bin/bash
# Magic Slash CLI
# Launch the Magic Slash Desktop app

APP_PATH="/Applications/Magic Slash.app"

# Read the version from the installed bundle. Settings live in the cloud, so the old
# ~/.config/magic-slash/config.json is no longer written and reported whatever version
# last wrote it — many releases behind the app it claimed to describe.
VERSION=$(defaults read "$APP_PATH/Contents/Info.plist" CFBundleShortVersionString 2>/dev/null || echo "unknown")

# Check for --help or -h flag
if [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
  echo ""
  echo "Magic Slash v$VERSION"
  echo ""
  echo "Usage:"
  echo "  magic-slash          Open the Magic Slash Desktop app"
  echo "  magic-slash --help   Show this help message"
  echo ""
  exit 0
fi

# Launch the desktop app
if [ -d "$APP_PATH" ]; then
  open -a "Magic Slash"
else
  echo "Error: Magic Slash Desktop app not found in /Applications."
  echo ""
  echo "Download it again:"
  echo "  https://github.com/xrequillart/magic-slash/releases/latest"
  exit 1
fi
